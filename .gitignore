# Dependencies
node_modules/

# Environment variables (secrets — never commit)
# Covers bare `.env` plus every variant, including suffixed ones
# like .env.bak and .env.save that exact-match rules miss.
.env
.env.*
!.env.example
!.env.*.example
.dev.vars

# Supabase temp files
supabase/.temp/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# Local scratch files
write-verify.js

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Version-controlled (explicitly allowed):
# - .env.example
# - .dev.vars.example
# - supabase/config.toml
# - supabase/migrations/*.sql

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~

# Playwright MCP page captures. 556 of these were committed to
# ev-accounts and held live credentials.
.playwright-mcp/

# Notes exports downloaded from the app. The browser writes these to the
# working directory, so one lands in the repo root whenever anyone clicks
# Export, under a new debate id each time. Each carries the exporter's own
# notes — which GET /notes is scoped to never hand to anyone else.
# Named for exactly what the route sets in Content-Disposition, so an
# unrelated PDF is never silently ignored.
debate-notes-*.pdf
